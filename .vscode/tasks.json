{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hackathon: запустить приложение",
      "type": "process",
      "command": "node",
      "args": ["server.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "hackathon",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^$",
          "endsPattern": "Money Graph:"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Hackathon: проверить проект",
      "type": "process",
      "command": "node",
      "args": ["--test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
